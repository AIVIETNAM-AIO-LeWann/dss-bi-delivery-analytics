{
  "name": "Delivery",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "vi-VN",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "RepoRoot",
        "kind": "m",
        "expression": "\"D:/Projects/dss-bi-delivery-analytics\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Orders",
        "lineageTag": "9b9252e7-89df-56e5-85e5-2d20e479ddcc",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none"
          },
          {
            "name": "month_start",
            "dataType": "dateTime",
            "sourceColumn": "month_start",
            "summarizeBy": "none",
            "formatString": "MMM yy"
          },
          {
            "name": "shipping_mode",
            "dataType": "string",
            "sourceColumn": "shipping_mode",
            "summarizeBy": "none"
          },
          {
            "name": "market",
            "dataType": "string",
            "sourceColumn": "market",
            "summarizeBy": "none"
          },
          {
            "name": "order_region",
            "dataType": "string",
            "sourceColumn": "order_region",
            "summarizeBy": "none"
          },
          {
            "name": "customer_segment",
            "dataType": "string",
            "sourceColumn": "customer_segment",
            "summarizeBy": "none"
          },
          {
            "name": "shipping_days_scheduled",
            "dataType": "int64",
            "sourceColumn": "shipping_days_scheduled",
            "summarizeBy": "none"
          },
          {
            "name": "shipping_days_actual",
            "dataType": "int64",
            "sourceColumn": "shipping_days_actual",
            "summarizeBy": "none"
          },
          {
            "name": "late_delivery_risk",
            "dataType": "int64",
            "sourceColumn": "late_delivery_risk",
            "summarizeBy": "none"
          },
          {
            "name": "partition",
            "dataType": "string",
            "sourceColumn": "partition",
            "summarizeBy": "none"
          },
          {
            "name": "P_Late",
            "dataType": "double",
            "sourceColumn": "P_Late",
            "summarizeBy": "none",
            "formatString": "0.00%"
          },
          {
            "name": "duration_mismatch_flag",
            "dataType": "int64",
            "sourceColumn": "duration_mismatch_flag",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(RepoRoot & \"/data/dashboard/orders.csv\"), [Delimiter=\",\", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"order_id\", type text}, {\"order_date\", type date}, {\"year_month\", type text}, {\"month_start\", type date}, {\"shipping_mode\", type text}, {\"market\", type text}, {\"order_region\", type text}, {\"customer_segment\", type text}, {\"shipping_days_scheduled\", Int64.Type}, {\"shipping_days_actual\", Int64.Type}, {\"late_delivery_risk\", Int64.Type}, {\"partition\", type text}, {\"P_Late\", type number}, {\"duration_mismatch_flag\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Số đơn",
            "expression": "COALESCE(COUNTROWS(Orders), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Số đơn trễ",
            "expression": "COALESCE(SUM(Orders[late_delivery_risk]), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Tỷ lệ trễ",
            "expression": "DIVIDE([Số đơn trễ], [Số đơn])",
            "formatString": "0.0%"
          },
          {
            "name": "Cam kết TB",
            "expression": "AVERAGE(Orders[shipping_days_scheduled])",
            "formatString": "0.00\" ngày\""
          },
          {
            "name": "Thực tế TB",
            "expression": "AVERAGE(Orders[shipping_days_actual])",
            "formatString": "0.00\" ngày\""
          },
          {
            "name": "Đơn test",
            "expression": "CALCULATE([Số đơn], Orders[partition] = \"test\")",
            "formatString": "#,0"
          },
          {
            "name": "Ngưỡng cảnh báo",
            "expression": "SELECTEDVALUE(RiskThreshold[Value], 0.5)",
            "formatString": "0.00"
          },
          {
            "name": "Cảnh báo",
            "expression": "VAR t = [Ngưỡng cảnh báo] RETURN CALCULATE([Đơn test], KEEPFILTERS(Orders[P_Late] >= t), KEEPFILTERS(NOT ISBLANK(Orders[P_Late])))",
            "formatString": "#,0"
          },
          {
            "name": "Cảnh báo đúng",
            "expression": "CALCULATE([Cảnh báo], Orders[late_delivery_risk] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "Đơn trễ test",
            "expression": "CALCULATE([Số đơn trễ], Orders[partition] = \"test\")",
            "formatString": "#,0"
          },
          {
            "name": "Precision theo ngưỡng",
            "expression": "DIVIDE([Cảnh báo đúng], [Cảnh báo])",
            "formatString": "0.0%"
          },
          {
            "name": "Recall theo ngưỡng",
            "expression": "DIVIDE([Cảnh báo đúng], [Đơn trễ test])",
            "formatString": "0.0%"
          },
          {
            "name": "Bỏ sót",
            "expression": "[Đơn trễ test] - [Cảnh báo đúng]",
            "formatString": "#,0"
          },
          {
            "name": "P_Late TB test",
            "expression": "CALCULATE(AVERAGE(Orders[P_Late]), Orders[partition] = \"test\")",
            "formatString": "0.0%"
          },
          {
            "name": "Chênh lệch cam kết",
            "expression": "[Thực tế TB] - [Cam kết TB]",
            "formatString": "0.00\" ngày\""
          },
          {
            "name": "Cảnh báo sai",
            "expression": "[Cảnh báo] - [Cảnh báo đúng]",
            "formatString": "#,0"
          },
          {
            "name": "Tỷ trọng cảnh báo",
            "expression": "DIVIDE([Cảnh báo], [Đơn test])",
            "formatString": "0.0%"
          },
          {
            "name": "Phương thức ưu tiên",
            "expression": "VAR t = FILTER(ADDCOLUMNS(VALUES(Orders[shipping_mode]), \"n\", [Số đơn], \"r\", [Tỷ lệ trễ]), [n] > 0) RETURN IF(COUNTROWS(t) > 0, MAXX(TOPN(1, t, [r], DESC, Orders[shipping_mode], ASC), Orders[shipping_mode]), \"Không có dữ liệu\")"
          },
          {
            "name": "Kỳ phân tích",
            "expression": "IF([Số đơn] > 0, FORMAT(MIN(Orders[order_date]), \"MM/yyyy\") & \" đến \" & FORMAT(MAX(Orders[order_date]), \"MM/yyyy\"), \"Không có dữ liệu\")"
          },
          {
            "name": "Số đơn toàn kỳ",
            "expression": "CALCULATE([Số đơn], REMOVEFILTERS(Orders))",
            "formatString": "#,0"
          },
          {
            "name": "Số tháng toàn kỳ",
            "expression": "CALCULATE(DISTINCTCOUNT(Orders[month_start]), REMOVEFILTERS(Orders))",
            "formatString": "#,0"
          },
          {
            "name": "Số thị trường toàn kỳ",
            "expression": "CALCULATE(DISTINCTCOUNT(Orders[market]), REMOVEFILTERS(Orders))",
            "formatString": "#,0"
          },
          {
            "name": "Tỷ lệ trễ toàn kỳ",
            "expression": "CALCULATE([Tỷ lệ trễ], REMOVEFILTERS(Orders))",
            "formatString": "0.0%"
          },
          {
            "name": "Chiếm đơn trễ",
            "expression": "DIVIDE([Số đơn trễ], CALCULATE([Số đơn trễ], REMOVEFILTERS(Orders[shipping_mode])))",
            "formatString": "0.0%"
          },
          {
            "name": "Chữ cam kết thực tế",
            "expression": "IF([Số đơn] > 0, FORMAT([Cam kết TB], \"0.00\", \"vi-VN\") & \" → \" & FORMAT([Thực tế TB], \"0.00\", \"vi-VN\") & \" ngày\", \"Chưa có\")"
          },
          {
            "name": "Chữ đơn và đơn trễ",
            "expression": "IF([Số đơn] > 0, FORMAT([Số đơn], \"#,0\", \"vi-VN\") & \" / \" & FORMAT([Số đơn trễ], \"#,0\", \"vi-VN\"), \"Chưa có\")"
          },
          {
            "name": "Chữ đơn trễ",
            "expression": "FORMAT([Số đơn trễ], \"#,0\", \"vi-VN\") & \" đơn trễ\""
          },
          {
            "name": "Chữ đơn đúng hạn",
            "expression": "FORMAT([Số đơn] - [Số đơn trễ], \"#,0\", \"vi-VN\") & \" đúng hạn\""
          },
          {
            "name": "Nhãn so với trung bình",
            "expression": "IF([Số đơn] = 0, \"\", IF([Tỷ lệ trễ] > [Tỷ lệ trễ toàn kỳ], \"▲ TRÊN TRUNG BÌNH\", \"▼ DƯỚI TRUNG BÌNH\"))"
          },
          {
            "name": "Cảnh báo đúng trên đơn test",
            "expression": "DIVIDE([Cảnh báo đúng], [Đơn test])",
            "formatString": "0.0%"
          },
          {
            "name": "Cảnh báo sai trên đơn test",
            "expression": "DIVIDE([Cảnh báo sai], [Đơn test])",
            "formatString": "0.0%"
          },
          {
            "name": "Bỏ sót trên đơn test",
            "expression": "DIVIDE([Bỏ sót], [Đơn test])",
            "formatString": "0.0%"
          },
          {
            "name": "Đơn trễ trên đơn test",
            "expression": "DIVIDE([Đơn trễ test], [Đơn test])",
            "formatString": "0.0%"
          },
          {
            "name": "Kết luận tổng quan",
            "expression": "VAR t = FILTER(ADDCOLUMNS(VALUES(Orders[shipping_mode]), \"n\", [Số đơn], \"r\", [Tỷ lệ trễ], \"l\", [Số đơn trễ]), [n] > 0)\nVAR a = TOPN(1, t, [r], DESC, Orders[shipping_mode], ASC)\nVAR b = TOPN(1, t, [l], DESC, Orders[shipping_mode], ASC)\nVAR total = SUMX(t, [l])\nRETURN IF(COUNTROWS(t) = 0, \"Không có dữ liệu\",\n    MAXX(a, Orders[shipping_mode]) & \" có tỷ lệ trễ cao nhất (\" & FORMAT(MAXX(a, [r]), \"0.0%\", \"vi-VN\") & \"); \"\n    & MAXX(b, Orders[shipping_mode]) & \" có nhiều đơn trễ nhất (\" & FORMAT(DIVIDE(MAXX(b, [l]), total), \"0.0%\", \"vi-VN\") & \" số đơn trễ).\")"
          },
          {
            "name": "Kết luận rủi ro",
            "expression": "IF([Cảnh báo] = 0, \"Không có cảnh báo ở ngưỡng đang chọn.\", \"Cảnh báo đúng \" & FORMAT([Precision theo ngưỡng], \"0.0%\", \"vi-VN\") & \" nhưng chỉ bắt được \" & FORMAT([Recall theo ngưỡng], \"0.0%\", \"vi-VN\") & \" đơn trễ; \" & FORMAT([Bỏ sót], \"#,0\", \"vi-VN\") & \" đơn trễ chưa được cảnh báo.\")"
          },
          {
            "name": "Đơn mỗi tháng",
            "expression": "DIVIDE([Số đơn], DISTINCTCOUNT(Orders[month_start]))",
            "formatString": "#,0"
          },
          {
            "name": "Chữ cảnh báo đúng",
            "expression": "FORMAT([Cảnh báo đúng], \"#,0\", \"vi-VN\") & \" đúng\""
          },
          {
            "name": "Chữ cảnh báo",
            "expression": "FORMAT([Cảnh báo], \"#,0\", \"vi-VN\") & \" được báo\""
          },
          {
            "name": "Chữ bắt được",
            "expression": "FORMAT([Cảnh báo đúng], \"#,0\", \"vi-VN\") & \" bắt được\""
          },
          {
            "name": "Chữ đơn trễ test",
            "expression": "FORMAT([Đơn trễ test], \"#,0\", \"vi-VN\") & \" đơn trễ\""
          },
          {
            "name": "Chữ cảnh báo sai",
            "expression": "\"Có thêm \" & FORMAT([Cảnh báo sai], \"#,0\", \"vi-VN\") & \" cảnh báo sai (báo trễ nhưng giao đúng hạn)\""
          },
          {
            "name": "Logo",
            "expression": "\"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%2272%22%20height=%2272%22%20viewBox=%220%200%2072%2072%22%3E%0A%3Cdefs%3E%0A%3ClinearGradient%20id=%22b%22%20x1=%220%22%20y1=%220%22%20x2=%221%22%20y2=%221%22%3E%3Cstop%20offset=%220%22%20stop-color=%22%23F1EEE7%22/%3E%3Cstop%20offset=%221%22%20stop-color=%22%23DAD6CC%22/%3E%3C/linearGradient%3E%0A%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%223%22%20dy=%224%22%20stdDeviation=%223.5%22%20flood-color=%22%23686044%22%20flood-opacity=%220.45%22/%3E%3C/filter%3E%0A%3C/defs%3E%0A%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%226%22%20y=%226%22%20width=%2260%22%20height=%2260%22%20rx=%2220%22%20fill=%22url%28%23b%29%22/%3E%3C/g%3E%0A%3Crect%20x=%2212%22%20y=%2212%22%20width=%2248%22%20height=%2248%22%20rx=%2215%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.22%22%20stroke-width=%222%22/%3E%0A%3Cg%20transform=%22translate%2836%2038%29%22%3E%0A%3Cpolygon%20points=%220,-17%2015,-8.5%200,0%20-15,-8.5%22%20fill=%22%2393C4C9%22/%3E%0A%3Cpolygon%20points=%22-15,-8.5%200,0%200,17%20-15,8.5%22%20fill=%22%230E7C86%22/%3E%0A%3Cpolygon%20points=%2215,-8.5%200,0%200,17%2015,8.5%22%20fill=%22%230A636B%22/%3E%0A%3Cpath%20d=%22M-15,-8.5%20L0,0%20L15,-8.5%20M0,0%20V17%22%20fill=%22none%22%20stroke=%22%23FFFFFF%22%20stroke-opacity=%22.5%22%20stroke-width=%221%22/%3E%0A%3Cpath%20d=%22M-8,-4.2%20L6,3.8%22%20stroke=%22%23FFFFFF%22%20stroke-opacity=%22.85%22%20stroke-width=%222%22%20stroke-linecap=%22round%22%20stroke-dasharray=%221%204%22/%3E%0A%3Ccircle%20cx=%2214%22%20cy=%22-14%22%20r=%226%22%20fill=%22%23D2472A%22%20stroke=%22%23F1EEE7%22%20stroke-width=%222.2%22/%3E%0A%3C/g%3E%3C/svg%3E\"",
            "dataCategory": "ImageUrl",
            "isHidden": true,
            "displayFolder": "Hình ảnh"
          },
          {
            "name": "Vòng tỷ lệ trễ",
            "expression": "VAR raw = [Tỷ lệ trễ]\nVAR v = MAX(0, MIN(1, COALESCE(raw, 0)))\nVAR txt = IF(ISBLANK(raw), \"–\", SUBSTITUTE(FORMAT(v, \"0.0%\", \"vi-VN\"), \"%\", \"%25\"))\nRETURN \"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22300%22%20height=%22214%22%20viewBox=%220%200%20300%20214%22%3E%0A%3Cdefs%3E%0A%3ClinearGradient%20id=%22g%22%20x1=%220%22%20y1=%220%22%20x2=%221%22%20y2=%221%22%3E%3Cstop%20offset=%220%22%20stop-color=%22%23E59483%22/%3E%3Cstop%20offset=%22.5%22%20stop-color=%22%23D2472A%22/%3E%3Cstop%20offset=%221%22%20stop-color=%22%239E3520%22/%3E%3C/linearGradient%3E%0A%3CradialGradient%20id=%22k%22%20cx=%22.35%22%20cy=%22.3%22%20r=%22.9%22%3E%3Cstop%20offset=%220%22%20stop-color=%22%23F1EEE7%22/%3E%3Cstop%20offset=%221%22%20stop-color=%22%23DAD6CC%22/%3E%3C/radialGradient%3E%0A%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%224%22%20dy=%225%22%20stdDeviation=%224%22%20flood-color=%22%23686044%22%20flood-opacity=%220.42%22/%3E%3C/filter%3E%0A%3C/defs%3E%0A%3Cline%20x1=%22150.0%22%20y1=%2219.0%22%20x2=%22150.0%22%20y2=%2210.0%22%20stroke=%22%2345545E%22%20stroke-width=%221.8%22%20opacity=%220.7%22/%3E%3Cline%20x1=%22163.8%22%20y1=%2220.1%22%20x2=%22164.2%22%20y2=%2217.1%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22177.2%22%20y1=%2223.3%22%20x2=%22178.1%22%20y2=%2220.5%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22190.0%22%20y1=%2228.6%22%20x2=%22191.3%22%20y2=%2225.9%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22201.7%22%20y1=%2235.8%22%20x2=%22203.5%22%20y2=%2233.4%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22212.2%22%20y1=%2244.8%22%20x2=%22215.8%22%20y2=%2241.2%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%