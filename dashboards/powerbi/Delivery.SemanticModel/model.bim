      },
      {
        "name": "PromiseScenarios",
        "lineageTag": "16ff6ead-41d6-5d15-a7b5-68e34cad4c65",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "policy_id",
            "dataType": "string",
            "sourceColumn": "policy_id",
            "summarizeBy": "none"
          },
          {
            "name": "proposed_days",
            "dataType": "int64",
            "sourceColumn": "proposed_days",
            "summarizeBy": "none"
          },
          {
            "name": "exceed_proposed",
            "dataType": "int64",
            "sourceColumn": "exceed_proposed",
            "summarizeBy": "none"
          },
          {
            "name": "fallback",
            "dataType": "int64",
            "sourceColumn": "fallback",
            "summarizeBy": "none"
          },
          {
            "name": "added_days",
            "dataType": "int64",
            "sourceColumn": "added_days",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "PromiseScenarios",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(RepoRoot & \"/data/dashboard/promise_scenarios.csv\"), [Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"order_id\", type text}, {\"policy_id\", type text}, {\"proposed_days\", Int64.Type}, {\"exceed_proposed\", Int64.Type}, {\"fallback\", Int64.Type}, {\"added_days\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Chính sách đang xem",
            "expression": "COALESCE(SELECTEDVALUE(PolicySelector[policy_label]), \"Thêm một ngày\")"
          },
          {
            "name": "Đơn kịch bản",
            "expression": "VAR p = COALESCE(SELECTEDVALUE(Policies[policy_id]), SELECTEDVALUE(PolicySelector[policy_id]), \"bounded_plus1_keep_same_day\") RETURN CALCULATE(COUNTROWS(PromiseScenarios), KEEPFILTERS(Policies[policy_id] = p))",
            "formatString": "#,0"
          },
          {
            "name": "Vượt hẹn tính lại",
            "expression": "VAR p = COALESCE(SELECTEDVALUE(Policies[policy_id]), SELECTEDVALUE(PolicySelector[policy_id]), \"bounded_plus1_keep_same_day\") RETURN DIVIDE(CALCULATE(SUM(PromiseScenarios[exceed_proposed]), KEEPFILTERS(Policies[policy_id] = p)), [Đơn kịch bản])",
            "formatString": "0.0%"
          },
          {
            "name": "Cam kết mới TB",
            "expression": "VAR p = COALESCE(SELECTEDVALUE(Policies[policy_id]), SELECTEDVALUE(PolicySelector[policy_id]), \"bounded_plus1_keep_same_day\") RETURN CALCULATE(AVERAGE(PromiseScenarios[proposed_days]), KEEPFILTERS(Policies[policy_id] = p))",
            "formatString": "0.00\" ngày\""
          },
          {
            "name": "Tăng cam kết TB",
            "expression": "VAR p = COALESCE(SELECTEDVALUE(Policies[policy_id]), SELECTEDVALUE(PolicySelector[policy_id]), \"bounded_plus1_keep_same_day\") RETURN CALCULATE(AVERAGE(PromiseScenarios[added_days]), KEEPFILTERS(Policies[policy_id] = p))",
            "formatString": "0.00\" ngày\""
          },
          {
            "name": "Trễ hiện trạng test",
            "expression": "DIVIDE([Đơn trễ test], [Đơn test])",
            "formatString": "0.0%"
          },
          {
            "name": "Giảm vượt hẹn (điểm %)",
            "expression": "IF([Đơn kịch bản] > 0, ([Trễ hiện trạng test] - [Vượt hẹn tính lại]) * 100)",
            "formatString": "0.0\" điểm %\""
          },
          {
            "name": "Nhóm cần rà soát cam kết",
            "expression": "VAR t = FILTER(ADDCOLUMNS(VALUES(Orders[shipping_mode]), \"n\", [Đơn kịch bản], \"r\", [Vượt hẹn tính lại]), [n] > 0) RETURN IF(COUNTROWS(t) > 0, MAXX(TOPN(1, t, [r], DESC, Orders[shipping_mode], ASC), Orders[shipping_mode]), \"Không có dữ liệu\")"
          },
          {
            "name": "Vượt hẹn nhóm cao nhất",
            "expression": "MAXX(VALUES(Orders[shipping_mode]), [Vượt hẹn tính lại])",
            "formatString": "0.0%"
          },
          {
            "name": "Cam kết hiện tại TB",
            "expression": "CALCULATE(AVERAGE(PromiseScenarios[proposed_days]), KEEPFILTERS(Policies[policy_id] = \"current\"))",
            "formatString": "0.00\" ngày\""
          },
          {
            "name": "Đơn vượt hẹn tính lại",
            "expression": "ROUND([Vượt hẹn tính lại] * [Đơn kịch bản], 0)",
            "formatString": "#,0"
          },
          {
            "name": "Đơn hết vượt hẹn",
            "expression": "[Đơn trễ test] - [Đơn vượt hẹn tính lại]",
            "formatString": "#,0"
          },
          {
            "name": "Dự phòng",
            "expression": "VAR p = COALESCE(SELECTEDVALUE(Policies[policy_id]), SELECTEDVALUE(PolicySelector[policy_id]), \"bounded_plus1_keep_same_day\") RETURN DIVIDE(CALCULATE(SUM(PromiseScenarios[fallback]), KEEPFILTERS(Policies[policy_id] = p)), [Đơn kịch bản])",
            "formatString": "0.0%"
          },
          {
            "name": "Kết luận cam kết",
            "expression": "IF([Đơn kịch bản] = 0, \"Không có dữ liệu\", [Chính sách đang xem] & \" đưa tỷ lệ vượt hẹn từ \" & FORMAT([Trễ hiện trạng test], \"0.0%\", \"vi-VN\") & \" xuống \" & FORMAT([Vượt hẹn tính lại], \"0.0%\", \"vi-VN\") & \", đổi lại khách chờ thêm trung bình \" & FORMAT([Tăng cam kết TB], \"0.00\", \"vi-VN\") & \" ngày; đây là đổi cam kết, thời gian giao thực tế không đổi.\")"
          },
          {
            "name": "Chữ hiện tại",
            "expression": "\"hiện tại \" & FORMAT([Trễ hiện trạng test], \"0.0%\", \"vi-VN\")"
          },
          {
            "name": "Chữ đơn vượt hẹn",
            "expression": "FORMAT([Đơn vượt hẹn tính lại], \"#,0\", \"vi-VN\") & \" đơn vượt hẹn\""
          },
          {
            "name": "Vòng vượt hẹn",
            "expression": "VAR raw = [Vượt hẹn tính lại]\nVAR v = MAX(0, MIN(1, COALESCE(raw, 0)))\nVAR txt = IF(ISBLANK(raw), \"–\", SUBSTITUTE(FORMAT(v, \"0.0%\", \"vi-VN\"), \"%\", \"%25\"))\nRETURN \"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22300%22%20height=%22214%22%20viewBox=%220%200%20300%20214%22%3E%0A%3Cdefs%3E%0A%3ClinearGradient%20id=%22g%22%20x1=%220%22%20y1=%220%22%20x2=%221%22%20y2=%221%22%3E%3Cstop%20offset=%220%22%20stop-color=%22%23E59483%22/%3E%3Cstop%20offset=%22.5%22%20stop-color=%22%23D2472A%22/%3E%3Cstop%20offset=%221%22%20stop-color=%22%239E3520%22/%3E%3C/linearGradient%3E%0A%3CradialGradient%20id=%22k%22%20cx=%22.35%22%20cy=%22.3%22%20r=%22.9%22%3E%3Cstop%20offset=%220%22%20stop-color=%22%23F1EEE7%22/%3E%3Cstop%20offset=%221%22%20stop-color=%22%23DAD6CC%22/%3E%3C/radialGradient%3E%0A%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%224%22%20dy=%225%22%20stdDeviation=%224%22%20flood-color=%22%23686044%22%20flood-opacity=%220.42%22/%3E%3C/filter%3E%0A%3C/defs%3E%0A%3Cline%20x1=%22150.0%22%20y1=%2219.0%22%20x2=%22150.0%22%20y2=%2210.0%22%20stroke=%22%2345545E%22%20stroke-width=%221.8%22%20opacity=%220.7%22/%3E%3Cline%20x1=%22163.8%22%20y1=%2220.1%22%20x2=%22164.2%22%20y2=%2217.1%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22177.2%22%20y1=%2223.3%22%20x2=%22178.1%22%20y2=%2220.5%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22190.0%22%20y1=%2228.6%22%20x2=%22191.3%22%20y2=%2225.9%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22201.7%22%20y1=%2235.8%22%20x2=%22203.5%22%20y2=%2233.4%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E%3Cline%20x1=%22212.2%22%20y1=%2244.8%22%20x2=%22215.8%22%20y2=%2241.2%22%20stroke=%22%2345545E%22%20stroke-width=%221%22%20opacity=%220.35%22/%3E