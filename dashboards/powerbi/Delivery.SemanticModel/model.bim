            "sourceColumn": "partition",
            "summarizeBy": "none"
          },
          {
            "name": "n",
            "dataType": "int64",
            "sourceColumn": "n",
            "summarizeBy": "none"
          },
          {
            "name": "late_count",
            "dataType": "int64",
            "sourceColumn": "late_count",
            "summarizeBy": "none"
          },
          {
            "name": "late_rate",
