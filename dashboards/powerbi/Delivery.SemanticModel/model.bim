            "sourceColumn": "late_rate",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "roc_auc",
            "dataType": "double",
            "sourceColumn": "roc_auc",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "average_precision",
            "dataType": "double",
            "sourceColumn": "average_precision",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "log_loss",
            "dataType": "double",
            "sourceColumn": "log_loss",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "brier",
            "dataType": "double",
            "sourceColumn": "brier",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "accuracy",
            "dataType": "double",
            "sourceColumn": "accuracy",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "precision",
            "dataType": "double",
            "sourceColumn": "precision",
