          {
            "name": "Thanh tỷ lệ trễ",
            "expression": "VAR v = MAX(0, MIN(1, COALESCE([Tỷ lệ trễ], 0)))\nVAR a = MAX(0, MIN(1, COALESCE([Tỷ lệ trễ toàn kỳ], 0)))\nRETURN \"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22240%22%20height=%2216%22%20viewBox=%220%200%20240%2016%22%3E%0A%3Cdefs%3E%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%221%22%20dy=%222%22%20stdDeviation=%221.5%22%20flood-color=%22%23686044%22%20flood-opacity=%220.4%22/%3E%3C/filter%3E%3C/defs%3E%0A%3Crect%20x=%220%22%20y=%220%22%20width=%22240%22%20height=%2216%22%20rx=%228%22%20fill=%22%23D3CFC4%22/%3E%0A%3Crect%20x=%220.75%22%20y=%220.75%22%20width=%22238.5%22%20height=%2214.5%22%20rx=%227.25%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.35%22%20stroke-width=%221.5%22/%3E%0A%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%223%22%20y=%223%22%20width=%22\" & FORMAT(MAX(4, v * 234), \"0.0\", \"en-US\") & \"%22%20height=%2210%22%20rx=%225%22%20fill=%22\" & IF(v > a, \"%23D2472A\", \"%230E7C86\") & \"%22/%3E%3C/g%3E%0A%3Crect%20x=%225%22%20y=%224%22%20width=%22\" & FORMAT(MAX(2, v * 234 - 4), \"0.0\", \"en-US\") & \"%22%20height=%222.6%22%20rx=%221.3%22%20fill=%22%23FFFFFF%22%20opacity=%22.38%22/%3E%0A%3Crect%20x=%22\" & FORMAT(2 + a * 234, \"0.0\", \"en-US\") & \"%22%20y=%220%22%20width=%222%22%20height=%2216%22%20fill=%22%231D2A33%22%20opacity=%22.55%22/%3E%0A%3C/svg%3E\"",
            "dataCategory": "ImageUrl",
            "isHidden": true,
            "displayFolder": "Hình ảnh"
          },
          {
            "name": "Nhiệt kế toàn kỳ",
            "expression": "VAR v = MAX(0, MIN(1, COALESCE([Tỷ lệ trễ toàn kỳ], 0)))\nRETURN \"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%2244%22%20height=%22250%22%20viewBox=%220%200%2044%20250%22%3E%0A%3Cdefs%3E%0A%3ClinearGradient%20id=%22f%22%20x1=%220%22%20y1=%220%22%20x2=%221%22%20y2=%220%22%3E%3Cstop%20offset=%220%22%20stop-color=%22%23E8A394%22/%3E%3Cstop%20offset=%221%22%20stop-color=%22%23D2472A%22/%3E%3C/linearGradient%3E%0A%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%222%22%20dy=%222%22%20stdDeviation=%222%22%20flood-color=%22%23686044%22%20flood-opacity=%220.4%22/%3E%3C/filter%3E%0A%3C/defs%3E%0A%3Crect%20x=%228%22%20y=%222%22%20width=%2228%22%20height=%22244%22%20rx=%2214%22%20fill=%22%23D3CFC4%22/%3E%0A%3Crect%20x=%228%22%20y=%222%22%20width=%2228%22%20height=%22244%22%20rx=%2214%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.4%22%20stroke-width=%222%22/%3E%0A%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%2212%22%20y=%22\" & FORMAT(6 + (1 - v) * 236, \"0.0\", \"en-US\") & \"%22%20width=%2220%22%20height=%22\" & FORMAT(MAX(4, v * 236), \"0.0\", \"en-US\") & \"%22%20rx=%2210%22%20fill=%22url%28%23f%29%22/%3E%3C/g%3E%0A%3Cline%20x1=%228%22%20y1=%22124%22%20x2=%2236%22%20y2=%22124%22%20stroke=%22%231D2A33%22%20stroke-opacity=%22.3%22/%3E%0A%3C/svg%3E\"",
            "dataCategory": "ImageUrl",
            "isHidden": true,
            "displayFolder": "Hình ảnh"
          },
          {
            "name": "Bàn phím nhiệt",
            "expression": "VAR grid = ADDCOLUMNS(\n    CROSSJOIN(VALUES(Orders[shipping_mode]), VALUES(Orders[market])),\n    \"ri\", SWITCH(Orders[shipping_mode], \"First Class\", 0, \"Second Class\", 1, \"Same Day\", 2, \"Standard Class\", 3, 4),\n    \"ci\", SWITCH(Orders[market], \"Africa\", 0, \"Europe\", 1, \"LATAM\", 2, \"Pacific Asia\", 3, \"USCA\", 4, 5),\n    \"val\", [Tỷ lệ trễ])\nVAR baseline = COALESCE([Tỷ lệ trễ], 0.57)\nRETURN \"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22340%22%20height=%22172%22%20viewBox=%220%200%20340%20172%22%3E%3Cdefs%3E%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%222%22%20dy=%223%22%20stdDeviation=%222.5%22%20flood-color=%22%23686044%22%20flood-opacity=%220.42%22/%3E%3C/filter%3E%3C/defs%3E%3Ctext%20x=%22114%22%20y=%2212%22%20text-anchor=%22middle%22%20font-family=%22Segoe%20UI%22%20font-size=%229.5%22%20fill=%22%235E6D76%22%3EAfrica%3C/text%3E%3Ctext%20x=%22163%22%20y=%2212%22%20text-anchor=%22middle%22%20font-family=%22Segoe%20UI%22%20font-size=%229.5%22%20fill=%22%235E6D76%22%3EEurope%3C/text%3E%3Ctext%20x=%22212%22%20y=%2212%22%20text-anchor=%22middle%22%20font-family=%22Segoe%20UI%22%20font-size=%229.5%22%20fill=%22%235E6D76%22%3ELATAM%3C/text%3E%3Ctext%20x=%22261%22%20y=%2212%22%20text-anchor=%22middle%22%20font-family=%22Segoe%20UI%22%20font-size=%229.5%22%20fill=%22%235E6D76%22%3EP.%20Asia%3C/text%3E%3Ctext%20x=%22310%22%20y=%2212%22%20text-anchor=%22middle%22%20font-family=%22Segoe%20UI%22%20font-size=%229.5%22%20fill=%22%235E6D76%22%3EUSCA%3C/text%3E%3Ctext%20x=%220%22%20y=%2239%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22600%22%20fill=%22%2345545E%22%3EFirst%20Class%3C/text%3E%3Ctext%20x=%220%22%20y=%2275%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22600%22%20fill=%22%2345545E%22%3ESecond%20Class%3C/text%3E%3Ctext%20x=%220%22%20y=%22111%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22600%22%20fill=%22%2345545E%22%3ESame%20Day%3C/text%3E%3Ctext%20x=%220%22%20y=%22147%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22600%22%20fill=%22%2345545E%22%3EStandard%20Class%3C/text%3E\" & CONCATENATEX(FILTER(grid, NOT ISBLANK([val])),\n    VAR v = [val]\n    VAR hot = v >= baseline\n    VAR t = IF(hot, MIN(1, DIVIDE(v - baseline, 1 - baseline)) * 0.95, MIN(1, DIVIDE(baseline - v, baseline - 0.38)) * 0.85)\n    VAR rr = ROUND(239 + (IF(hot, 210, 14) - 239) * t, 0)\n    VAR gg = ROUND(236 + (IF(hot, 71, 124) - 236) * t, 0)\n    VAR bb = ROUND(229 + (IF(hot, 42, 134) - 229) * t, 0)\n    VAR strong = v > 0.7 || v < 0.45\n    RETURN \"%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%22\" & FORMAT(92 + [ci] * 49, \"0\", \"en-US\") & \"%22%20y=%22\" & FORMAT(20 + [ri] * 36, \"0\", \"en-US\") & \"%22%20width=%2244%22%20height=%2230%22%20rx=%229%22%20fill=%22rgb%28\" & FORMAT(rr, \"0\", \"en-US\") & \",\" & FORMAT(gg, \"0\", \"en-US\") & \",\" & FORMAT(bb, \"0\", \"en-US\") & \"%29%22/%3E%3C/g%3E%3Ctext%20x=%22\" & FORMAT(92 + [ci] * 49 + 22, \"0\", \"en-US\") & \"%22%20y=%22\" & FORMAT(20 + [ri] * 36 + 20, \"0\", \"en-US\") & \"%22%20text-anchor=%22middle%22%20font-family=%22Segoe%20UI%22%20font-size=%2212%22%20font-weight=%22700%22%20fill=%22\" & IF(strong, \"%23FFFFFF\", \"%231D2A33\") & \"%22%3E\" & SUBSTITUTE(FORMAT(v, \"0%\", \"vi-VN\"), \"%\", \"%25\") & \"%3C/text%3E\", \"\") & \"%3C/svg%3E\"",
            "dataCategory": "ImageUrl",
            "isHidden": true,
            "displayFolder": "Hình ảnh"
          },
          {
            "name": "Phễu phát hiện",
            "expression": "VAR tot = COALESCE([Đơn test], 0)\nVAR late = COALESCE([Đơn trễ test], 0)\nVAR caught = COALESCE([Cảnh báo đúng], 0)\nVAR missed = COALESCE([Bỏ sót], 0)\nRETURN IF(tot = 0, BLANK(), \"data:image/svg+xml;utf8,\" & \"%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22592%22%20height=%22200%22%20viewBox=%220%200%20592%20200%22%3E%3Cdefs%3E%3Cfilter%20id=%22s%22%20x=%22-30%25%22%20y=%22-30%25%22%20width=%22160%25%22%20height=%22160%25%22%3E%3CfeDropShadow%20dx=%222%22%20dy=%223%22%20stdDeviation=%222.5%22%20flood-color=%22%23686044%22%20flood-opacity=%220.4%22/%3E%3C/filter%3E%3C/defs%3E%3Ctext%20x=%220%22%20y=%2219%22%20font-family=%22Segoe%20UI%22%20font-size=%2216%22%20font-weight=%22600%22%20fill=%22%231D2A33%22%3E\" & FORMAT(tot, \"#,0\", \"vi-VN\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%2235%22%20font-family=%22Segoe%20UI%22%20font-size=%2211%22%20fill=%22%235E6D76%22%3E%C4%91%C6%A1n%20ki%E1%BB%83m%20tra%3C/text%3E%3Crect%20x=%22136%22%20y=%224%22%20width=%22456%22%20height=%2232%22%20rx=%2211%22%20fill=%22%23D3CFC4%22/%3E%3Crect%20x=%22136.75%22%20y=%224.75%22%20width=%22454.5%22%20height=%2230.5%22%20rx=%2210.25%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.35%22%20stroke-width=%221.5%22/%3E%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%22140%22%20y=%228%22%20width=%22\" & FORMAT(MAX(6, DIVIDE(tot, tot) * 448), \"0.0\", \"en-US\") & \"%22%20height=%2224%22%20rx=%228%22%20fill=%22%238E9AA3%22/%3E%3C/g%3E%3Ctext%20x=%22152%22%20y=%2224%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22700%22%20fill=%22%231D2A33%22%3E\" & SUBSTITUTE(FORMAT(DIVIDE(tot, tot), \"0.0%\", \"vi-VN\"), \"%\", \"%25\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%2267%22%20font-family=%22Segoe%20UI%22%20font-size=%2216%22%20font-weight=%22600%22%20fill=%22%231D2A33%22%3E\" & FORMAT(late, \"#,0\", \"vi-VN\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%2283%22%20font-family=%22Segoe%20UI%22%20font-size=%2211%22%20fill=%22%235E6D76%22%3E%C4%91%C6%A1n%20tr%E1%BB%85%20th%E1%BB%B1c%20t%E1%BA%BF%3C/text%3E%3Crect%20x=%22136%22%20y=%2252%22%20width=%22456%22%20height=%2232%22%20rx=%2211%22%20fill=%22%23D3CFC4%22/%3E%3Crect%20x=%22136.75%22%20y=%2252.75%22%20width=%22454.5%22%20height=%2230.5%22%20rx=%2210.25%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.35%22%20stroke-width=%221.5%22/%3E%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%22140%22%20y=%2256%22%20width=%22\" & FORMAT(MAX(6, DIVIDE(late, tot) * 448), \"0.0\", \"en-US\") & \"%22%20height=%2224%22%20rx=%228%22%20fill=%22%23B8860B%22/%3E%3C/g%3E%3Ctext%20x=%22152%22%20y=%2272%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22700%22%20fill=%22%231D2A33%22%3E\" & SUBSTITUTE(FORMAT(DIVIDE(late, tot), \"0.0%\", \"vi-VN\"), \"%\", \"%25\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%22115%22%20font-family=%22Segoe%20UI%22%20font-size=%2216%22%20font-weight=%22600%22%20fill=%22%231D2A33%22%3E\" & FORMAT(caught, \"#,0\", \"vi-VN\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%22131%22%20font-family=%22Segoe%20UI%22%20font-size=%2211%22%20fill=%22%235E6D76%22%3Ec%E1%BA%A3nh%20b%C3%A1o%20%C4%91%C3%BAng%3C/text%3E%3Crect%20x=%22136%22%20y=%22100%22%20width=%22456%22%20height=%2232%22%20rx=%2211%22%20fill=%22%23D3CFC4%22/%3E%3Crect%20x=%22136.75%22%20y=%22100.75%22%20width=%22454.5%22%20height=%2230.5%22%20rx=%2210.25%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.35%22%20stroke-width=%221.5%22/%3E%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%22140%22%20y=%22104%22%20width=%22\" & FORMAT(MAX(6, DIVIDE(caught, tot) * 448), \"0.0\", \"en-US\") & \"%22%20height=%2224%22%20rx=%228%22%20fill=%22%230E7C86%22/%3E%3C/g%3E%3Ctext%20x=%22152%22%20y=%22120%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22700%22%20fill=%22%23FFFFFF%22%3E\" & SUBSTITUTE(FORMAT(DIVIDE(caught, tot), \"0.0%\", \"vi-VN\"), \"%\", \"%25\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%22163%22%20font-family=%22Segoe%20UI%22%20font-size=%2216%22%20font-weight=%22600%22%20fill=%22%231D2A33%22%3E\" & FORMAT(missed, \"#,0\", \"vi-VN\") & \"%3C/text%3E%3Ctext%20x=%220%22%20y=%22179%22%20font-family=%22Segoe%20UI%22%20font-size=%2211%22%20fill=%22%235E6D76%22%3Eb%E1%BB%8F%20s%C3%B3t%3C/text%3E%3Crect%20x=%22136%22%20y=%22148%22%20width=%22456%22%20height=%2232%22%20rx=%2211%22%20fill=%22%23D3CFC4%22/%3E%3Crect%20x=%22136.75%22%20y=%22148.75%22%20width=%22454.5%22%20height=%2230.5%22%20rx=%2210.25%22%20fill=%22none%22%20stroke=%22%23686044%22%20stroke-opacity=%22.35%22%20stroke-width=%221.5%22/%3E%3Cg%20filter=%22url%28%23s%29%22%3E%3Crect%20x=%22140%22%20y=%22152%22%20width=%22\" & FORMAT(MAX(6, DIVIDE(missed, tot) * 448), \"0.0\", \"en-US\") & \"%22%20height=%2224%22%20rx=%228%22%20fill=%22%23D2472A%22/%3E%3C/g%3E%3Ctext%20x=%22152%22%20y=%22168%22%20font-family=%22Segoe%20UI%22%20font-size=%2211.5%22%20font-weight=%22700%22%20fill=%22%23FFFFFF%22%3E\" & SUBSTITUTE(FORMAT(DIVIDE(missed, tot), \"0.0%\", \"vi-VN\"), \"%\", \"%25\") & \"%3C/text%3E%3C/svg%3E\")",
            "dataCategory": "ImageUrl",
            "isHidden": true,
            "displayFolder": "Hình ảnh"
          },
          {
