          }
        ],
        "partitions": [
          {
            "name": "RouteCases",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(RepoRoot & \"/data/dashboard/route_cases.csv\"), [Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"case_id\", type text}, {\"instance\", type text}, {\"scenario\", type text}, {\"method\", type text}, {\"max_vehicles\", Int64.Type}, {\"capacity\", Int64.Type}, {\"status\", type text}, {\"vehicles_used\", Int64.Type}, {\"distance_units\", type number}, {\"case_label\", type text}, {\"route_image\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Quãng đường benchmark",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]) && SELECTEDVALUE(RouteCases[status]) = \"feasible\", SELECTEDVALUE(RouteCases[distance_units]))",
            "formatString": "0.00"
          },
          {
            "name": "Số xe sử dụng",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]) && SELECTEDVALUE(RouteCases[status]) = \"feasible\", SELECTEDVALUE(RouteCases[vehicles_used]))",
            "formatString": "#,0"
          },
          {
            "name": "Km mô phỏng",
            "expression": "[Quãng đường benchmark] * SELECTEDVALUE(KmPerUnit[Value], 1)",
            "formatString": "0.00"
          },
          {
            "name": "Nhiên liệu mô phỏng",
            "expression": "[Km mô phỏng] * SELECTEDVALUE(FuelConsumption[Value], 10) / 100 * SELECTEDVALUE(FuelPrice[Value], 22000)",
            "formatString": "#,0"
          },
          {
            "name": "Trạng thái tuyến",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]), IF(SELECTEDVALUE(RouteCases[status]) = \"feasible\", \"Có tuyến khả thi — chưa chứng minh tối ưu\", \"Chưa tìm được lời giải — không quy về 0\"), \"Chọn đúng một case_id để xem tuyến và chi phí\")"
          },
          {
            "name": "Bản đồ tuyến",
            "expression": "SELECTEDVALUE(RouteCases[route_image])",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Quãng đường đối chiếu",
            "expression": "VAR i = SELECTEDVALUE(RouteCases[instance])\nVAR s = SELECTEDVALUE(RouteCases[scenario])\nVAR k = SELECTEDVALUE(RouteCases[max_vehicles])\nVAR q = SELECTEDVALUE(RouteCases[capacity])\nVAR m = SELECTEDVALUE(RouteMethods[method])\nRETURN IF(HASONEVALUE(RouteCases[case_id]), CALCULATE(MAX(RouteCases[distance_units]), REMOVEFILTERS(RouteCases),\nRouteCases[instance] = i, RouteCases[scenario] = s, RouteCases[max_vehicles] = k,\nRouteCases[capacity] = q, RouteCases[method] = m, RouteCases[status] = \"feasible\"))",
            "formatString": "0.0"
          },
          {
            "name": "Xe đối chiếu",
            "expression": "VAR i = SELECTEDVALUE(RouteCases[instance])\nVAR s = SELECTEDVALUE(RouteCases[scenario])\nVAR k = SELECTEDVALUE(RouteCases[max_vehicles])\nVAR q = SELECTEDVALUE(RouteCases[capacity])\nVAR m = SELECTEDVALUE(RouteMethods[method])\nRETURN IF(HASONEVALUE(RouteCases[case_id]), CALCULATE(MAX(RouteCases[vehicles_used]), REMOVEFILTERS(RouteCases),\nRouteCases[instance] = i, RouteCases[scenario] = s, RouteCases[max_vehicles] = k,\nRouteCases[capacity] = q, RouteCases[method] = m, RouteCases[status] = \"feasible\"))",
            "formatString": "#,0"
          },
          {
            "name": "Trạng thái đối chiếu",
            "expression": "IF(ISBLANK([Quãng đường đối chiếu]), \"Chưa có lời giải\", \"Khả thi\")"
          },
          {
            "name": "Giảm quãng đường",
            "expression": "VAR d = [Quãng đường benchmark]\nVAR i = SELECTEDVALUE(RouteCases[instance])\nVAR s = SELECTEDVALUE(RouteCases[scenario])\nVAR k = SELECTEDVALUE(RouteCases[max_vehicles])\nVAR q = SELECTEDVALUE(RouteCases[capacity])\nVAR b = CALCULATE(MAX(RouteCases[distance_units]), REMOVEFILTERS(RouteCases), RouteCases[instance] = i,\nRouteCases[scenario] = s, RouteCases[max_vehicles] = k, RouteCases[capacity] = q,\nRouteCases[method] = \"nearest_feasible\", RouteCases[status] = \"feasible\")\nRETURN IF(NOT ISBLANK(d) && NOT ISBLANK(b), DIVIDE(b - d, b))",
            "formatString": "0.0%"
          },
          {
            "name": "Chữ tiêu hao",
            "expression": "FORMAT(SELECTEDVALUE(FuelConsumption[Value], 10), \"0\", \"vi-VN\") & \" lít / 100 km\""
          },
          {
            "name": "Chữ giá nhiên liệu",
            "expression": "FORMAT(SELECTEDVALUE(FuelPrice[Value], 22000), \"#,0\", \"vi-VN\") & \" VND / lít\""
          },
          {
            "name": "Chữ quy đổi",
            "expression": "FORMAT(SELECTEDVALUE(KmPerUnit[Value], 1), \"0.0\", \"vi-VN\") & \" km / đơn vị\""
          },
          {
            "name": "Chữ tải trọng",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]), FORMAT(SELECTEDVALUE(RouteCases[capacity]), \"#,0\", \"vi-VN\") & \" / xe\", \"—\")"
          },
          {
            "name": "Chữ xe tối đa",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]), FORMAT(SELECTEDVALUE(RouteCases[max_vehicles]), \"0\", \"vi-VN\") & \" xe\", \"—\")"
          },
          {
            "name": "Kết luận tuyến",
            "expression": "IF(NOT ISBLANK([Quãng đường benchmark]), \"Phương án này dùng \" & FORMAT([Số xe sử dụng], \"0\", \"vi-VN\") & \" xe và \" & FORMAT([Quãng đường benchmark], \"#,0.0\", \"vi-VN\") & \" đơn vị quãng đường\" & IF(NOT ISBLANK([Giảm quãng đường]), \", ngắn hơn \" & FORMAT([Giảm quãng đường], \"0.0%\", \"vi-VN\") & \" so với điểm gần nhất cùng cấu hình\", \"\") & \"; nhiên liệu mô phỏng \" & FORMAT([Nhiên liệu mô phỏng], \"#,0\", \"vi-VN\") & \" VND theo giả định đã chọn.\", [Trạng thái tuyến])"
          },
          {
            "name": "Thẻ Quãng đường benchmark",
            "expression": "IF(ISBLANK([Quãng đường benchmark]), \"Chưa có\", FORMAT([Quãng đường benchmark], \"0.00\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Số xe sử dụng",
            "expression": "IF(ISBLANK([Số xe sử dụng]), \"Chưa có\", FORMAT([Số xe sử dụng], \"#,0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Km mô phỏng",
            "expression": "IF(ISBLANK([Km mô phỏng]), \"Chưa có\", FORMAT([Km mô phỏng], \"0.00\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Nhiên liệu mô phỏng",
            "expression": "IF(ISBLANK([Nhiên liệu mô phỏng]), \"Chưa có\", FORMAT([Nhiên liệu mô phỏng], \"#,0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Quãng đường đối chiếu",
            "expression": "IF(ISBLANK([Quãng đường đối chiếu]), \"Chưa có\", FORMAT([Quãng đường đối chiếu], \"0.0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Xe đối chiếu",
            "expression": "IF(ISBLANK([Xe đối chiếu]), \"Chưa có\", FORMAT([Xe đối chiếu], \"#,0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Giảm quãng đường",
            "expression": "IF(ISBLANK([Giảm quãng đường]), \"Chưa có\", FORMAT([Giảm quãng đường], \"0.0%\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          }
        ]
      },
      {
        "name": "RouteStops",
        "lineageTag": "bf1abbff-5bdb-5d82-8d77-5b30025097f0",
        "columns": [
          {
            "name": "sequence",
            "dataType": "int64",
            "sourceColumn": "sequence",
            "summarizeBy": "none"
          },
          {
            "name": "node",
            "dataType": "int64",
            "sourceColumn": "node",
            "summarizeBy": "none"
          },
          {
            "name": "x",
            "dataType": "double",
            "sourceColumn": "x",
            "summarizeBy": "none"
          },
          {
            "name": "y",
            "dataType": "double",
            "sourceColumn": "y",
            "summarizeBy": "none"
          },
          {
            "name": "vehicle",
            "dataType": "string",
            "sourceColumn": "vehicle",
            "summarizeBy": "none"
          },
          {
            "name": "case_id",
            "dataType": "string",
            "sourceColumn": "case_id",
            "summarizeBy": "none"
          },
          {
            "name": "stop_key",
            "dataType": "string",
            "sourceColumn": "stop_key",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "RouteStops",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(RepoRoot & \"/data/dashboard/route_stops.csv\"), [Delimiter=\",\", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"sequence\", Int64.Type}, {\"node\", Int64.Type}, {\"x\", type number}, {\"y\", type number}, {\"vehicle\", type text}, {\"case_id\", type text}, {\"stop_key\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Node tuyến",
            "expression": "SELECTEDVALUE(RouteStops[node])",
            "formatString": "#,0"
          },
          {
            "name": "Thứ tự dừng",
            "expression": "SELECTEDVALUE(RouteStops[sequence])",
            "formatString": "#,0"
          },
          {
            "name": "Tọa độ X",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]), AVERAGE(RouteStops[x]))",
            "formatString": "0.0"
          },
          {
            "name": "Tọa độ Y",
            "expression": "IF(HASONEVALUE(RouteCases[case_id]), AVERAGE(RouteStops[y]))",
            "formatString": "0.0"
          },
          {
            "name": "Thẻ Node tuyến",
            "expression": "IF(ISBLANK([Node tuyến]), \"Chưa có\", FORMAT([Node tuyến], \"#,0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Thứ tự dừng",
            "expression": "IF(ISBLANK([Thứ tự dừng]), \"Chưa có\", FORMAT([Thứ tự dừng], \"#,0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Tọa độ X",
            "expression": "IF(ISBLANK([Tọa độ X]), \"Chưa có\", FORMAT([Tọa độ X], \"0.0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Tọa độ Y",
            "expression": "IF(ISBLANK([Tọa độ Y]), \"Chưa có\", FORMAT([Tọa độ Y], \"0.0\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          }
        ]
      },
