        "partitions": [
          {
            "name": "ModelMetrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(RepoRoot & \"/data/dashboard/model_metrics.csv\"), [Delimiter=\",\", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"model\", type text}, {\"partition\", type text}, {\"n\", Int64.Type}, {\"late_count\", Int64.Type}, {\"late_rate\", type number}, {\"roc_auc\", type number}, {\"average_precision\", type number}, {\"log_loss\", type number}, {\"brier\", type number}, {\"accuracy\", type number}, {\"precision\", type number}, {\"recall\", type number}, {\"f1\", type number}, {\"threshold\", type number}, {\"tn\", Int64.Type}, {\"fp\", Int64.Type}, {\"fn\", Int64.Type}, {\"tp\", Int64.Type}, {\"model_label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "AUC baseline test",
            "expression": "CALCULATE(MAX(ModelMetrics[roc_auc]), ModelMetrics[model] = \"mode_baseline\", ModelMetrics[partition] = \"test\")",
            "formatString": "0.000"
          },
          {
            "name": "Log loss baseline test",
            "expression": "CALCULATE(MAX(ModelMetrics[log_loss]), ModelMetrics[model] = \"mode_baseline\", ModelMetrics[partition] = \"test\")",
            "formatString": "0.000"
          },
          {
            "name": "AP ngoài mẫu",
            "expression": "CALCULATE(MAX(ModelMetrics[average_precision]), ModelMetrics[partition] = \"test\")",
            "formatString": "0.000"
          },
          {
            "name": "AUC ngoài mẫu",
            "expression": "CALCULATE(MAX(ModelMetrics[roc_auc]), ModelMetrics[partition] = \"test\")",
            "formatString": "0.000"
          },
          {
            "name": "Log loss ngoài mẫu",
            "expression": "CALCULATE(MAX(ModelMetrics[log_loss]), ModelMetrics[partition] = \"test\")",
            "formatString": "0.000"
          },
          {
            "name": "Thẻ AUC baseline test",
            "expression": "IF(ISBLANK([AUC baseline test]), \"Chưa có\", FORMAT([AUC baseline test], \"0.000\", \"vi-VN\"))",
            "isHidden": true,
            "displayFolder": "Trình bày"
          },
          {
            "name": "Thẻ Log loss baseline test",
